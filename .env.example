DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_db?schema=public"
# AI provider: set ONE of these. When both are omitted, the backend uses
# deterministic fallback streaming (no LLM).
# Groq (https://console.groq.com) — keys start with gsk_. Takes priority.
GROQ_API_KEY=""
# xAI Grok (https://console.x.ai) — keys start with xai-.
XAI_API_KEY=""
# Optional model override (defaults: llama-3.3-70b-versatile on Groq, grok-3 on xAI)
AI_MODEL=""
PORT="3000"
VITE_API_BASE_URL="http://localhost:3000"
